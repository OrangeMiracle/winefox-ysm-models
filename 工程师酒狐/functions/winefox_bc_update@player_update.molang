// Better Combat owns the attack choice. Never count a three-hit combo here.
// Explicit blocks are required here: YSM 2.6.5 mis-evaluates the shorthand
// conditional assignment. tools/test_ysm.py exercises the actual parser.
t.action = 0;
t.eligible = ctrl.hold('mainhand', ':sword') && ysm.swinging_arm == 0;
t.eligible ? {
    (ctrl.bcombat_attack_animation == 'one_handed_slash_horizontal_right' || ctrl.bcombat_attack_animation == '"one_handed_slash_horizontal_right"') ? { t.action = 1; };
    (ctrl.bcombat_attack_animation == 'one_handed_slash_horizontal_left' || ctrl.bcombat_attack_animation == '"one_handed_slash_horizontal_left"') ? { t.action = 2; };
    (ctrl.bcombat_attack_animation == 'one_handed_stab' || ctrl.bcombat_attack_animation == '"one_handed_stab"') ? { t.action = 3; };
};
// Input ending does not mean the authored follow-through has finished.
// Track input separately so a same-name attack after a gap starts immediately.
t.restart = t.action > 0 && (t.action != v.winefox_bc_input || (ysm.swinging && ysm.swing_time < v.winefox_bc_last_swing));
t.restart ? {
    v.winefox_bc_start = query.life_time;
    v.winefox_bc_speed = math.clamp(ysm.attack_speed, 0.1, 20);
};
// Absolute render time is invariant to repeated evaluation in the same frame.
v.winefox_bc_phase = math.min(1, math.max(0, query.life_time - v.winefox_bc_start) * v.winefox_bc_speed);
t.recover = t.eligible && (ctrl.bcombat_attack_animation == '' || ctrl.bcombat_attack_animation == '""') && v.winefox_bc_action > 0 && v.winefox_bc_phase < 1;
v.winefox_bc_input = t.action;
(t.action == 0 && t.recover) ? { t.action = v.winefox_bc_action; };
v.winefox_bc_action = t.action;
(t.action == 0) ? { v.winefox_bc_phase = 0; };
v.winefox_bc_last_swing = ysm.swing_time;
