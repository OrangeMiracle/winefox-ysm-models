{
	"format_version": "1.19.0",
	"animation_controllers": {
		"player.swing": {
			"initial_state": "ysm-builtin",
			"states": {
				"ysm-builtin": {
					"transitions": [
						{
							"right": "v.winefox_bc_action == 1"
						},
						{
							"left": "v.winefox_bc_action == 2"
						},
						{
							"stab": "v.winefox_bc_action == 3"
						}
					],
					"blend_transition": 0.04
				},
				"right": {
					"transitions": [
						{
							"left": "v.winefox_bc_action == 2"
						},
						{
							"stab": "v.winefox_bc_action == 3"
						},
						{
							"ysm-builtin": "v.winefox_bc_action == 0"
						}
					],
					"blend_transition": 0.04,
					"animations": [
						"winefox_bc_right"
					]
				},
				"left": {
					"transitions": [
						{
							"right": "v.winefox_bc_action == 1"
						},
						{
							"stab": "v.winefox_bc_action == 3"
						},
						{
							"ysm-builtin": "v.winefox_bc_action == 0"
						}
					],
					"blend_transition": 0.04,
					"animations": [
						"winefox_bc_left"
					]
				},
				"stab": {
					"transitions": [
						{
							"right": "v.winefox_bc_action == 1"
						},
						{
							"left": "v.winefox_bc_action == 2"
						},
						{
							"ysm-builtin": "v.winefox_bc_action == 0"
						}
					],
					"blend_transition": 0.04,
					"animations": [
						"winefox_bc_stab"
					]
				}
			}
		}
	}
}
